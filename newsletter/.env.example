# ============================================================================
# TOSSON ENVIRONMENTAL ANALYTICS — NEWSLETTER PIPELINE ENVIRONMENT (.env.example)
# Copy to .env on Muse's operator VM. NEVER commit real secrets to Git.
# ============================================================================

# 1. Publication & Identity Metadata (Non-Secret)
NEWSLETTER_NAME="Carolina PFAS Weekly"
NEWSLETTER_TAGLINE="North Carolina's Weekly PFAS & Water Quality Intelligence Briefing"
NEWSLETTER_AUTHOR="Dr. Temitope D. Soneye, PhD"
NEWSLETTER_FROM_EMAIL="briefing@tossonanalytics.com"
NEWSLETTER_REPLY_TO="temitope.soneye@tossonllc.com"
NEWSLETTER_SITE_URL="https://tossonanalytics.com"
NEWSLETTER_ARCHIVE_BASE_URL="https://tossonanalytics.com/insights"
NEWSLETTER_UNSUBSCRIBE_URL="https://tossonanalytics.com/api/unsubscribe"
NEWSLETTER_PHYSICAL_ADDRESS="Tosson Services LLC dba Tosson Environmental Analytics · 3118 Hannaford Drive, Mebane, NC 27302"

# 2. Crawler Identification & Rate Limiting (§1.2 Etiquette)
CRAWLER_USER_AGENT="TossonAnalytics-NewsletterBot/1.0 (+https://tossonanalytics.com/about; mailto:temitope.soneye@tossonllc.com)"
CRAWLER_CONTACT_EMAIL="temitope.soneye@tossonllc.com"
CRAWLER_MIN_DELAY_MS="1200"
CRAWLER_CACHE_TTL_HOURS="168"

# 3. Primary Email Delivery Stack (Buttondown OR Resend Broadcasts — Draft-Only API)
# IMPORTANT (§1.5): The pipeline ONLY creates drafts (`status: "draft"`) for
# Dr. Soneye's human approval. It NEVER auto-sends to subscribers.
EMAIL_PROVIDER="buttondown"                  # Options: "buttondown" | "resend" | "kit" | "local-only"
BUTTONDOWN_API_KEY="bd_placeholder_replace_on_vm"
RESEND_API_KEY="re_placeholder_replace_on_vm"
RESEND_AUDIENCE_ID="aud_placeholder_replace_on_vm"
KIT_API_KEY="kit_placeholder_replace_on_vm"

# 4. Optional AI Summarization Assistance (Cloud API — No Local GPU Required per §3.7)
# Used ONLY when drafting candidate summaries from raw feed items; all outputs
# still pass the deterministic Framing Guard (§1.3) and Owner Review Gate (§1.5).
LLM_PROVIDER="none"                          # Options: "none" | "openrouter" | "anthropic" | "gemini"
OPENROUTER_API_KEY="or_placeholder_replace_on_vm"
OPENROUTER_MODEL="google/gemini-2.5-flash"

# 5. Cloudflare Pages Subscribe Endpoint & Double Opt-In Secrets (Used by functions/api/subscribe.ts)
# Bind `SUBSCRIBERS_D1` or `SUBSCRIBERS_KV` in wrangler.toml.
SUBSCRIBE_HMAC_SECRET="replace_with_32_byte_random_hex_on_cloudflare"
REQUIRE_DOUBLE_OPT_IN="true"
